# Browser-side Web3Forms key: fallback delivery for every lead form
WEB3FORMS_KEY=your_web3forms_key_here

# /api/lead — server-side lead email (Resend). Without it, leads go through Web3Forms.
RESEND_API_KEY=
LEAD_EMAIL_FROM="Allometrik Leads <leads@allometrik.com>"
LEAD_EMAIL_TO=hello@allometrik.com

# Company enrichment summary (optional; one of these). Without a key, only website metadata is included.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Newsletter opt-in (optional; only used when the visitor ticks the consent box)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend API (for expedition lead capture)
# RESEND_CONTACTS_API_KEY: Optional full-access key for audience/contact management
# If not set, RESEND_API_KEY is used (may be sending-only and fail audience/contact calls)
# Audience/contact failures are logged but non-fatal — subscriber email still sent
RESEND_CONTACTS_API_KEY=
RESEND_SHENZHEN_AUDIENCE_ID=

# Google Sheets lead logging (optional)
# If set, all leads (contact form, modal, expedition) are logged to Google Sheets via Apps Script webhook
LEADS_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
LEADS_SHEET_TOKEN=your_secret_token_here
